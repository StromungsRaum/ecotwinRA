apiVersion: v1
clusters:
- cluster:
    certificate-authority-data: 
    server: https://localhost:8443/clusters/root:providers:ianus
  name: workspace.kcp.io/current
- cluster:
    certificate-authority-data: 
    server: https://localhost:8443/clusters/root:providers
  name: workspace.kcp.io/previous
contexts:
- context:
    cluster: workspace.kcp.io/current
    user: kcp-admin
  name: workspace.kcp.io/current
- context:
    cluster: workspace.kcp.io/previous
    user: kcp-admin
  name: workspace.kcp.io/previous
current-context: workspace.kcp.io/current
kind: Config
users:
- name: kcp-admin
  user:
    client-certificate-data: 
    client-key-data: 
